<Window x:Class="ShowNetLog.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShowNetLog"
        mc:Ignorable="d"
        Title="NetLimiter Log Viewer" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox x:Name="FilterTextBox" Width="300" TextChanged="FilterTextBox_TextChanged" Margin="0,0,10,0"/>
            <Button Content="Refresh" Click="RefreshButton_Click" Padding="10,2"/>
        </StackPanel>
        
        <DataGrid x:Name="LogDataGrid" Grid.Row="1" Margin="10" AutoGenerateColumns="False" IsReadOnly="True" AlternatingRowBackground="#F0F0F0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Start Time" Binding="{Binding StartTime}"/>
                <DataGridTextColumn Header="Duration" Binding="{Binding Duration}"/>
                <DataGridTextColumn Header="App Path" Binding="{Binding AppPath}" Width="200"/>
                <DataGridTextColumn Header="Proto" Binding="{Binding Protocol}"/>
                <DataGridTextColumn Header="Local IP" Binding="{Binding LocalIp}"/>
                <DataGridTextColumn Header="LPort" Binding="{Binding LocalPort}"/>
                <DataGridTextColumn Header="Remote IP" Binding="{Binding RemoteIp}"/>
                <DataGridTextColumn Header="RPort" Binding="{Binding RemotePort}"/>
                <DataGridTextColumn Header="Local Domain" Binding="{Binding LocalDomain}"/>
                <DataGridTextColumn Header="Remote Domain" Binding="{Binding RemoteDomain}"/>
                <DataGridTextColumn Header="Data In" Binding="{Binding DataIn}"/>
                <DataGridTextColumn Header="Data Out" Binding="{Binding DataOut}"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock x:Name="StatusTextBlock" Text="Ready"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
